generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model UserPreferences {
  email String @unique(map: "P") @db.VarChar(100)

  prefersDarkMode Boolean @default(false)
}

model Keys {
  email String @unique(map: "P") @db.VarChar(100)
  token String @db.VarChar(100)
  bases Base[]
}

model Base {
  id       String  @unique(map: "P") @db.VarChar(50)
  email    String  @db.VarChar(100)
  name     String  @db.VarChar(255)
  active   Boolean @default(true)
  tables   Table[]
  key      Keys    @relation(fields: [keysEmail], references: [email])
  apiToken String?

  keysEmail String    @db.VarChar(100)
  Request   Request[]

  @@index([keysEmail])
}

model Table {
  id     String  @unique(map: "P") @db.VarChar(50)
  name   String  @db.VarChar(255)
  active Boolean @default(true)
  ttl    Int     @default(3600) @db.UnsignedMediumInt
  base   Base?   @relation(fields: [baseId], references: [id])
  views  View[]

  baseId  String?   @db.VarChar(50)
  Request Request[]

  @@index([baseId])
}

model View {
  id    String @unique(map: "P") @db.VarChar(50)
  name  String @db.VarChar(255)
  type  String @db.VarChar(10)
  table Table? @relation(fields: [tableId], references: [id])

  tableId String? @db.VarChar(50)

  @@index([tableId])
}

model Request {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @db.DateTime(0)
  base      Base     @relation(fields: [baseId], references: [id])
  table     Table    @relation(fields: [tableId], references: [id])
  asn       Int      @db.UnsignedMediumInt
  continent String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  region    String   @db.VarChar(100)
  city      String   @db.VarChar(100)
  latitude  Float
  longitude Float
  latlng    String
  baseId    String   @db.VarChar(50)
  tableId   String   @db.VarChar(50)

  @@index([baseId])
  @@index([tableId])
  @@index([baseId, tableId, createdAt])
  @@index(latlng)
}

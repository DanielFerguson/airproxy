generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model UserPreferences {
  email String @unique(map: "P") @db.VarChar(255)

  prefersDarkMode Boolean @default(false)
}

model Keys {
  email String @unique(map: "P") @db.VarChar(255)
  token String @db.VarChar(255)
  bases Base[]
}

model Base {
  id     String  @unique(map: "P") @db.VarChar(255)
  email  String  @db.VarChar(255)
  name   String  @db.VarChar(255)
  active Boolean @default(true)
  tables Table[]
  key    Keys    @relation(fields: [keysEmail], references: [email])

  keysEmail String @db.VarChar(255)

  @@index([keysEmail])
}

model Table {
  id     String  @unique(map: "P") @db.VarChar(255)
  name   String  @db.VarChar(255)
  active Boolean @default(true)
  base   Base?   @relation(fields: [baseId], references: [id])
  views  View[]

  baseId String? @db.VarChar(255)

  @@index([baseId])
}

model View {
  id    String @unique(map: "P") @db.VarChar(255)
  name  String @db.VarChar(255)
  type  String @db.VarChar(255)
  table Table? @relation(fields: [tableId], references: [id])

  tableId String? @db.VarChar(255)

  @@index([tableId])
}

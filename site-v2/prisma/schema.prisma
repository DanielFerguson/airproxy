generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  prefersDarkMode      Boolean               @default(false)
  createdAt            DateTime              @default(now()) @db.DateTime(0)
  accounts             Account[]
  sessions             Session[]
  base                 Base[]
  personalAccessTokens PersonalAccessToken[]
  Subscription         Subscription[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  oauth_token              String? @db.Text
  oauth_token_secret       String? @db.Text
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique(provider)
  @@unique([provider, providerAccountId], name: "provider_providerAccountId")
  @@index(userId)
}

model Subscription {
  subscriptionId String   @id
  orderId        Int
  status         String
  renewsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime
  updatedAt      DateTime
  userId         String?
  productName    String
  user           User?    @relation(fields: [userId], references: [id])

  @@index(userId)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index(userId)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PersonalAccessToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(0)
  userId    String?  @db.VarChar(50)
  user      User?    @relation(fields: [userId], references: [id])
  bases     Base[]

  @@index(userId)
}

model Base {
  id                    String               @id @unique(map: "P") @db.VarChar(50)
  name                  String               @db.VarChar(255)
  active                Boolean              @default(true)
  ttl                   Int                  @default(3600) @db.UnsignedMediumInt
  apiToken              String?              @db.VarChar(36)
  userId                String?              @db.VarChar(50)
  personalAccessTokenId String?              @db.VarChar(100)
  personalAccessToken   PersonalAccessToken? @relation(fields: [personalAccessTokenId], references: [token])
  user                  User?                @relation(fields: [userId], references: [id])
  tables                Table[]
  requests              Request[]

  @@index(personalAccessTokenId)
  @@index(userId)
}

model Table {
  id       String    @id @unique(map: "P") @db.VarChar(50)
  name     String    @db.VarChar(255)
  active   Boolean   @default(true)
  ttl      Int       @default(3600) @db.UnsignedMediumInt
  baseId   String?   @db.VarChar(50)
  base     Base?     @relation(fields: [baseId], references: [id])
  views    View[]
  requests Request[]

  @@index(baseId)
}

model View {
  id      String  @id @unique(map: "P") @db.VarChar(50)
  name    String  @db.VarChar(255)
  type    String  @db.VarChar(10)
  active  Boolean @default(true)
  tableId String? @db.VarChar(50)
  table   Table?  @relation(fields: [tableId], references: [id])

  @@index(tableId)
}

model Request {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @db.DateTime(0)
  asn       Int      @db.UnsignedMediumInt
  continent String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  region    String   @db.VarChar(100)
  city      String   @db.VarChar(100)
  latitude  Float
  longitude Float
  latlng    String
  baseId    String   @db.VarChar(50)
  tableId   String   @db.VarChar(50)
  base      Base     @relation(fields: [baseId], references: [id])
  table     Table    @relation(fields: [tableId], references: [id])

  @@index(baseId)
  @@index(tableId)
  @@index([baseId, tableId, createdAt])
}

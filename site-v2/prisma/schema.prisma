generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  prefersDarkMode Boolean @default(false)

  accounts             Account[]
  sessions             Session[]
  base                 Base[]
  personalAccessTokens PersonalAccessToken[]
  Subscription         Subscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_providerAccountId")
  @@index([userId])
}

model Subscription {
  subscriptionId String   @id
  orderId        Int
  status         String
  renewsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime
  updatedAt      DateTime
  productName    String
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PersonalAccessToken {
  id        String   @id @default(cuid())
  token     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(0)
  user      User?    @relation(fields: [userId], references: [id])
  bases     Base[]

  userId String? @db.VarChar(50)

  @@unique([token])
  @@index([userId])
}

model Base {
  id                    String               @id @unique(map: "P") @db.VarChar(50)
  name                  String               @db.VarChar(255)
  active                Boolean              @default(true)
  ttl                   Int                  @default(3600) @db.UnsignedMediumInt
  personalAccessToken   PersonalAccessToken? @relation(fields: [personalAccessTokenId], references: [token])
  user                  User?                @relation(fields: [userId], references: [id])
  apiToken              String?              @db.VarChar(36)
  tables                Table[]
  requests              Request[]
  userId                String?              @db.VarChar(50)
  personalAccessTokenId String?              @db.VarChar(100)

  @@index([personalAccessTokenId])
  @@index([userId])
}

model Table {
  id       String    @id @unique(map: "P") @db.VarChar(50)
  name     String    @db.VarChar(255)
  active   Boolean   @default(true)
  ttl      Int       @default(3600) @db.UnsignedMediumInt
  base     Base?     @relation(fields: [baseId], references: [id])
  views    View[]
  requests Request[]
  baseId   String?   @db.VarChar(50)

  @@index([baseId])
}

model View {
  id      String  @id @unique(map: "P") @db.VarChar(50)
  name    String  @db.VarChar(255)
  type    String  @db.VarChar(10)
  active  Boolean @default(true)
  table   Table?  @relation(fields: [tableId], references: [id])
  tableId String? @db.VarChar(50)

  @@index([tableId])
}

model Request {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @db.DateTime(0)
  base      Base     @relation(fields: [baseId], references: [id])
  table     Table    @relation(fields: [tableId], references: [id])
  asn       Int      @db.UnsignedMediumInt
  continent String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  region    String   @db.VarChar(100)
  city      String   @db.VarChar(100)
  latitude  Float
  longitude Float
  latlng    String
  baseId    String   @db.VarChar(50)
  tableId   String   @db.VarChar(50)

  @@index([baseId])
  @@index([tableId])
  @@index([baseId, tableId, createdAt])
}
